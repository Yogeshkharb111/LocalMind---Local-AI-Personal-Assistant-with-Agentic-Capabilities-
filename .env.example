# ==============================================================
# LocalMind Configuration — copy this to .env and fill in values
#   cp .env.example .env
# ==============================================================

# --- LLM Backend: any OpenAI-compatible /chat/completions endpoint ---
#
# Option A — OpenRouter (cloud, many models). Get a key at
#   https://openrouter.ai/keys   then uncomment these three lines:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-your-openrouter-key
# LLM_MODEL=openrouter/auto
#
# Option B — Ollama (local, free, zero data leaves machine).
#   Run:  ollama serve   and   ollama pull kimi-k2.5:cloud
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=kimi-k2.5:cloud

# Optional OpenRouter attribution headers (recommended by OpenRouter,
# ignored by other backends).
OPENROUTER_REFERER=
OPENROUTER_TITLE=LocalMind

# --- Telegram Bot (BotFather token) ---
# Create a bot with @BotFather, then paste the token here.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone (not recommended).
TELEGRAM_ALLOWED_USERS=

# --- Telegram MCP (Telethon — your personal account, OPTIONAL) ---
# Get API credentials at https://my.telegram.org/apps
# Generate the session string with: python scripts/gen_telegram_session.py
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=

# Path to a cloned chigwell/telegram-mcp repo (OPTIONAL — enables 60+ tools).
#   git clone https://github.com/chigwell/telegram-mcp.git
#   cd telegram-mcp && uv sync
# Then set the absolute path here. If empty, "uvx telegram-mcp" is used.
TELEGRAM_MCP_DIR=

# Allowed root directories for Telegram file tools (send_file, download_media).
# Space-separated absolute paths. Defaults to your home dir + /tmp if empty.
TELEGRAM_MCP_FILE_ROOTS=

# --- Windows MCP (OPTIONAL, Windows only) ---
WINDOWS_MCP_TELEMETRY=false

# --- GitHub MCP (OPTIONAL) ---
# Create a token at https://github.com/settings/tokens (scopes: repo, issues)
GITHUB_TOKEN=
GITHUB_TOOLSETS=repos,issues,pull_requests

# --- LinkedIn MCP (OPTIONAL) ---
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# --- Bot Persona ---
BOT_NAME=LocalMind
BOT_VERSION=2.0.0

# --- RAG Settings ---
CHROMA_PERSIST_DIR=./data/chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5
RAG_MIN_SCORE=0.3

# --- Memory ---
MEMORY_DIR=./data/memory
MAX_CONVERSATION_HISTORY=20

# --- Intent Classification (legacy; router is LLM-first) ---
INTENT_MODE=rule

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./data/logs/localmind.log

# --- Paths ---
SKILLS_DIR=./skills
DAILY_LOGS_DIR=./data/daily_logs
