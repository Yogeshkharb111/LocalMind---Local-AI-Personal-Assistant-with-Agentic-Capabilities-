# MCP Server Configuration Reference
# This file documents all MCP servers used by LocalMind
# and their configuration for external MCP clients (Cursor, etc.)

# ────────────────────────────────────────────────────────────
# MCP Client Config (e.g. your MCP client's config file)
# Location: your MCP client's config directory (macOS)
#           your MCP client's config directory (Windows)
# ────────────────────────────────────────────────────────────

{
  "mcpServers": {
    "telegram-mcp": {
      "command": "uvx",
      "args": ["telegram-mcp"],
      "env": {
        "TELEGRAM_API_ID": "YOUR_TELEGRAM_API_ID",
        "TELEGRAM_API_HASH": "YOUR_TELEGRAM_API_HASH",
        "TELEGRAM_SESSION_STRING": "YOUR_SESSION_STRING"
      }
    },
    "github-mcp-server": {
      "command": "uvx",
      "args": ["github-mcp-server", "stdio"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_TOKEN"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/path/to/allowed/directory"
      ]
    },
    "windows-mcp": {
      "command": "uvx",
      "args": ["windows-mcp"]
    },
    "linkedin-mcp-server": {
      "command": "uvx",
      "args": ["linkedin-mcp-server"],
      "env": {
        "LINKEDIN_EMAIL": "YOUR_LINKEDIN_EMAIL",
        "LINKEDIN_PASSWORD": "YOUR_LINKEDIN_PASSWORD"
      }
    }
  }
}
